# ─── Database ────────────────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# Neon:     Dashboard → Connection details → pooled connection string
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL used inside setup links shared on WhatsApp
APP_URL="http://localhost:3000"

# ─── Web Push (VAPID) — generate with `npm run vapid` ────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ─── File storage (Supabase Storage / any S3-compatible) — optional in dev ──
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="campusly-private"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for the cron endpoint (/api/v1/cron/*). Use a long random string.
CRON_SECRET=""
